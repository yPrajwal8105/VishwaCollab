# ============================================
# VishwaCollab - Environment Variables
# ============================================
# Copy this file to .env.local (Next.js) for local dev
# For production: set these in your hosting dashboard
# ============================================

# --- Supabase (Next.js / AI features) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- MySQL (PHP backend - set on server for production) ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=vishwacollab

# --- App URL (change for production) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASE_URL=http://localhost/Vishwacollab/

# --- APIs ---
OPENAI_API_KEY=sk-your-openai-key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
